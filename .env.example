# Gemini
GEMINI_API_KEY=your_gemini_api_key

# GitHub — for committing tools.json updates
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=stacksense
GITHUB_BRANCH=main

# Brave Search API — for web research (free tier: 2000 searches/mo)
# Get at: https://api.search.brave.com
BRAVE_API_KEY=your_brave_search_api_key

# Slack — for notifications
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url
SLACK_CHANNEL=#stacksense

# Agent config
SCAN_SCHEDULE="0 9 * * *"   # every day at 9am
AUDIT_SCHEDULE="0 10 * * *"  # every day at 10am
MAX_TOOLS_PER_SCAN=3
TOOLS_JSON_PATH=lib/tools.json
LOG_LEVEL=info
